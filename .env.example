# AutoGen SME Platform Configuration

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FILE=logs/varga-ai.log

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/varga_ai
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# AutoGen
AUTOGEN_CACHE_DIR=.cache/autogen
AUTOGEN_WORK_DIR=./work_dir

# Rate Limiting
GLOBAL_RATE_LIMIT_PER_MINUTE=1000
GLOBAL_RATE_LIMIT_PER_HOUR=10000

# Web Search Tool
TOOL_WEB_SEARCH_ENABLED=true
TOOL_WEB_SEARCH_RATE_LIMIT_PER_MINUTE=60
TOOL_WEB_SEARCH_RATE_LIMIT_PER_HOUR=1000
TOOL_WEB_SEARCH_SEARCH_ENGINE=serpapi
SERPAPI_API_KEY=your-serpapi-key-here
# Alternative: GOOGLE_SEARCH_API_KEY and GOOGLE_CX_ID
# Alternative: BING_SEARCH_API_KEY

# Text Generation Tool
TOOL_TEXT_GENERATION_ENABLED=true
TOOL_TEXT_GENERATION_RATE_LIMIT_PER_MINUTE=60
TOOL_TEXT_GENERATION_RATE_LIMIT_PER_HOUR=1000
TOOL_TEXT_GENERATION_MODEL_PROVIDER=openai
TOOL_TEXT_GENERATION_MODEL_NAME=gpt-4
OPENAI_API_KEY=your-openai-api-key-here
# Alternative: ANTHROPIC_API_KEY
# Alternative: AZURE_OPENAI_API_KEY and AZURE_OPENAI_ENDPOINT

# Chatbot Interface Tool
TOOL_CHATBOT_INTERFACE_ENABLED=true
TOOL_CHATBOT_INTERFACE_RATE_LIMIT_PER_MINUTE=100
TOOL_CHATBOT_INTERFACE_RATE_LIMIT_PER_HOUR=2000
TOOL_CHATBOT_INTERFACE_MODEL_PROVIDER=openai
TOOL_CHATBOT_INTERFACE_MODEL_NAME=gpt-4
TOOL_CHATBOT_INTERFACE_MAX_CONVERSATION_LENGTH=50
TOOL_CHATBOT_INTERFACE_CONTEXT_WINDOW_TOKENS=8000