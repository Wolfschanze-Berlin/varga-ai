# Language Teacher Telegram Bot Configuration
# Copy this file to .env and fill in your actual values

# Telegram Bot Configuration (Required)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Get this from @BotFather on Telegram

# OpenAI Configuration (Optional - for advanced AI features)
OPENAI_API_KEY=your_openai_api_key_here
# Get from https://platform.openai.com/api-keys

# Anthropic Configuration (Optional - alternative AI provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Get from https://console.anthropic.com/

# Bot Configuration
BOT_ENVIRONMENT=development
# development, staging, or production

# Database Configuration
DATABASE_URL=sqlite:///language_learners.db
# For SQLite (local development)

# Voice Processing Configuration
ENABLE_VOICE_FEATURES=true
SPEECH_RECOGNITION_PROVIDER=mock
# Options: mock, openai_whisper, google_speech

# Learning Configuration
DEFAULT_LANGUAGE=english
SUPPORTED_LANGUAGES=english,spanish,french,german,italian,portuguese
MAX_SESSION_DURATION=60
ENABLE_ACHIEVEMENTS=true

# Logging Configuration
LOG_LEVEL=INFO
# DEBUG, INFO, WARNING, ERROR

# Rate Limiting
RATE_LIMIT_MESSAGES_PER_MINUTE=30
RATE_LIMIT_VOICE_PER_HOUR=10

# Security
WEBHOOK_SECRET=your_webhook_secret_here
# Optional: For webhook security

# Analytics (Optional)
ENABLE_ANALYTICS=true
ANALYTICS_RETENTION_DAYS=90

# Performance
CACHE_TTL_MINUTES=5
DB_CONNECTION_POOL_SIZE=10